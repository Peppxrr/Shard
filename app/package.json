{
  "name": "shard",
  "productName": "Shard",
  "version": "0.1.2",
  "description": "Medal-style game clipper — RAM replay buffer, hotkeys, library, editor, Discord-size exports.",
  "license": "GPL-2.0",
  "private": true,
  "main": "dist/main/main/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build && tsc -p tsconfig.main.json",
    "test:editor": "node --no-warnings --experimental-strip-types scripts/test-editor.mjs",
    "postinstall": "node scripts/postinstall.mjs",
    "package": "npm run build && node scripts/verify-core-bin.mjs && electron-builder --win"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "uiohook-napi": "^1.5.5"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.5",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.9.0",
    "vite": "^8.2.1"
  }
}
