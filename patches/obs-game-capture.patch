+static bool authenticode_signer(const wchar_t *path, char signer_name[256], char thumbprint[41],
+				LONG *trust_status)
+{
+	WINTRUST_FILE_INFO file_info = {0};
+	WINTRUST_DATA trust = {0};
+	GUID action = WINTRUST_ACTION_GENERIC_VERIFY_V2;
+	HCERTSTORE store = NULL;
+	HCRYPTMSG message = NULL;
+	CMSG_SIGNER_INFO *signer = NULL;
+	PCCERT_CONTEXT certificate = NULL;
+	DWORD encoding = 0;
+	DWORD content_type = 0;
+	DWORD format_type = 0;
+	DWORD signer_size = 0;
+	BYTE certificate_hash[20];
+	DWORD certificate_hash_size = sizeof(certificate_hash);
+	bool success = false;
+
+	file_info.cbStruct = sizeof(file_info);
+	file_info.pcwszFilePath = path;
+	trust.cbStruct = sizeof(trust);
+	trust.dwUIChoice = WTD_UI_NONE;
+	trust.fdwRevocationChecks = WTD_REVOKE_NONE;
+	trust.dwUnionChoice = WTD_CHOICE_FILE;
+	trust.pFile = &file_info;
+	trust.dwStateAction = WTD_STATEACTION_VERIFY;
+	trust.dwProvFlags = WTD_CACHE_ONLY_URL_RETRIEVAL;
+
+	*trust_status = WinVerifyTrust(INVALID_HANDLE_VALUE, &action, &trust);
+	if (*trust_status != ERROR_SUCCESS)
+		goto cleanup;
+
+	if (!CryptQueryObject(CERT_QUERY_OBJECT_FILE, path, CERT_QUERY_CONTENT_FLAG_PKCS7_SIGNED_EMBED,
+			      CERT_QUERY_FORMAT_FLAG_BINARY, 0, &encoding, &content_type, &format_type, &store,
+			      &message, NULL))
+		goto cleanup;
+	if (!CryptMsgGetParam(message, CMSG_SIGNER_INFO_PARAM, 0, NULL, &signer_size))
+		goto cleanup;
+	signer = bmalloc(signer_size);
+	if (!CryptMsgGetParam(message, CMSG_SIGNER_INFO_PARAM, 0, signer, &signer_size))
+		goto cleanup;
+
+	CERT_INFO certificate_info = {0};
+	certificate_info.Issuer = signer->Issuer;
+	certificate_info.SerialNumber = signer->SerialNumber;
+	certificate = CertFindCertificateInStore(store, X509_ASN_ENCODING | PKCS_7_ASN_ENCODING, 0,
+						 CERT_FIND_SUBJECT_CERT, &certificate_info, NULL);
+	if (!certificate ||
+	    !CertGetCertificateContextProperty(certificate, CERT_SHA1_HASH_PROP_ID, certificate_hash,
+					       &certificate_hash_size) ||
+	    certificate_hash_size != sizeof(certificate_hash))
+		goto cleanup;
+	if (CertGetNameStringA(certificate, CERT_NAME_SIMPLE_DISPLAY_TYPE, 0, NULL, signer_name, 256) <= 1)
+		goto cleanup;
+
+	bytes_to_hex(certificate_hash, certificate_hash_size, thumbprint);
+	success = true;
+
+cleanup:
+	trust.dwStateAction = WTD_STATEACTION_CLOSE;
+	WinVerifyTrust(INVALID_HANDLE_VALUE, &action, &trust);
+	if (certificate)
+		CertFreeCertificateContext(certificate);
+	bfree(signer);
+	if (message)
+		CryptMsgClose(message);
+	if (store)
+		CertCloseStore(store, 0);
+	return success;
+}
