diff --git a/plugins/win-capture/CMakeLists.txt b/plugins/win-capture/CMakeLists.txt
index 2214917cc..75c9b17c7 100644
--- a/plugins/win-capture/CMakeLists.txt
+++ b/plugins/win-capture/CMakeLists.txt
@@ -1,5 +1,82 @@
 cmake_minimum_required(VERSION 3.28...3.30)
 
+# Shard packages the official signed OBS release payload instead of rebuilding
+# the target-side hook and helpers. Validate the pinned bytes at configure time
+# and embed the same manifest values in the host plugin for runtime checks.
+if(NOT SHARD_OBS_HOOK_PAYLOAD_DIR)
+  message(FATAL_ERROR "SHARD_OBS_HOOK_PAYLOAD_DIR is required")
+endif()
+
+set(_shard_hook_manifest "${SHARD_OBS_HOOK_PAYLOAD_DIR}/manifest.json")
+if(NOT EXISTS "${_shard_hook_manifest}")
+  message(FATAL_ERROR "OBS Game Capture payload manifest not found: ${_shard_hook_manifest}")
+endif()
+
+file(READ "${_shard_hook_manifest}" _shard_hook_manifest_json)
+string(JSON SHARD_OBS_HOOK_PAYLOAD_VERSION GET "${_shard_hook_manifest_json}" obsVersion)
+string(JSON SHARD_OBS_HOOK_PAYLOAD_COMMIT GET "${_shard_hook_manifest_json}" obsCommit)
+string(JSON SHARD_OBS_HOOK_SIGNER GET "${_shard_hook_manifest_json}" signer)
+string(JSON SHARD_GRAPHICS_HOOK64_SHA256 GET "${_shard_hook_manifest_json}" files graphics-hook64.dll sha256)
+string(JSON SHARD_GRAPHICS_HOOK32_SHA256 GET "${_shard_hook_manifest_json}" files graphics-hook32.dll sha256)
+string(JSON SHARD_INJECT_HELPER64_SHA256 GET "${_shard_hook_manifest_json}" files inject-helper64.exe sha256)
+string(JSON SHARD_INJECT_HELPER32_SHA256 GET "${_shard_hook_manifest_json}" files inject-helper32.exe sha256)
+string(JSON SHARD_GRAPHICS_HOOK64_SIGNER GET "${_shard_hook_manifest_json}" files graphics-hook64.dll signerThumbprint)
+string(JSON SHARD_GRAPHICS_HOOK32_SIGNER GET "${_shard_hook_manifest_json}" files graphics-hook32.dll signerThumbprint)
+string(JSON SHARD_INJECT_HELPER64_SIGNER GET "${_shard_hook_manifest_json}" files inject-helper64.exe signerThumbprint)
+string(JSON SHARD_INJECT_HELPER32_SIGNER GET "${_shard_hook_manifest_json}" files inject-helper32.exe signerThumbprint)
+
+if(NOT SHARD_OBS_HOOK_PAYLOAD_VERSION STREQUAL OBS_VERSION_CANONICAL)
+  message(FATAL_ERROR
+    "win-capture ${OBS_VERSION_CANONICAL} cannot use OBS Game Capture payload ${SHARD_OBS_HOOK_PAYLOAD_VERSION}"
+  )
+endif()
+
+foreach(
+  _payload
+  "graphics-hook64.dll;${SHARD_GRAPHICS_HOOK64_SHA256}"
+  "graphics-hook32.dll;${SHARD_GRAPHICS_HOOK32_SHA256}"
+  "inject-helper64.exe;${SHARD_INJECT_HELPER64_SHA256}"
+  "inject-helper32.exe;${SHARD_INJECT_HELPER32_SHA256}"
+)
+  list(GET _payload 0 _payload_name)
+  list(GET _payload 1 _payload_sha256)
+  set(_payload_path "${SHARD_OBS_HOOK_PAYLOAD_DIR}/${_payload_name}")
+  if(NOT EXISTS "${_payload_path}")
+    message(FATAL_ERROR "Official OBS Game Capture payload missing: ${_payload_path}")
+  endif()
+  file(SHA256 "${_payload_path}" _payload_actual_sha256)
+  if(NOT _payload_actual_sha256 STREQUAL _payload_sha256)
+    message(FATAL_ERROR
+      "Official OBS Game Capture payload hash mismatch for ${_payload_name}: "
+      "expected ${_payload_sha256}, got ${_payload_actual_sha256}"
+    )
+  endif()
+endforeach()
+
+file(
+  CONFIGURE
+  OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/hook-payload-manifest.h"
+  CONTENT
+    [=[
+#pragma once
+
+#define SHARD_OBS_HOOK_PAYLOAD_VERSION "@SHARD_OBS_HOOK_PAYLOAD_VERSION@"
+#define SHARD_OBS_HOOK_PAYLOAD_COMMIT "@SHARD_OBS_HOOK_PAYLOAD_COMMIT@"
+#define SHARD_OBS_HOOK_SIGNER "@SHARD_OBS_HOOK_SIGNER@"
+
+#define SHARD_GRAPHICS_HOOK64_SHA256 "@SHARD_GRAPHICS_HOOK64_SHA256@"
+#define SHARD_GRAPHICS_HOOK32_SHA256 "@SHARD_GRAPHICS_HOOK32_SHA256@"
+#define SHARD_INJECT_HELPER64_SHA256 "@SHARD_INJECT_HELPER64_SHA256@"
+#define SHARD_INJECT_HELPER32_SHA256 "@SHARD_INJECT_HELPER32_SHA256@"
+
+#define SHARD_GRAPHICS_HOOK64_SIGNER "@SHARD_GRAPHICS_HOOK64_SIGNER@"
+#define SHARD_GRAPHICS_HOOK32_SIGNER "@SHARD_GRAPHICS_HOOK32_SIGNER@"
+#define SHARD_INJECT_HELPER64_SIGNER "@SHARD_INJECT_HELPER64_SIGNER@"
+#define SHARD_INJECT_HELPER32_SIGNER "@SHARD_INJECT_HELPER32_SIGNER@"
+]=]
+  @ONLY
+)
+
 if(NOT TARGET OBS::obfuscate)
   add_subdirectory("${CMAKE_SOURCE_DIR}/libobs" "${CMAKE_BINARY_DIR}/libobs")
 endif()
