+static void bytes_to_hex(const BYTE *bytes, DWORD size, char *hex)
+{
+	static const char digits[] = "0123456789ABCDEF";
+	for (DWORD i = 0; i < size; i++) {
+		hex[i * 2] = digits[bytes[i] >> 4];
+		hex[i * 2 + 1] = digits[bytes[i] & 0x0F];
+	}
+	hex[size * 2] = '\0';
+}
